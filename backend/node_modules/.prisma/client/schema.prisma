// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  passwordHash       String
  role               Role              @default(OPERATOR)
  warehouseId        String?
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  sessions           Session[]
  activityLogs       ActivityLog[]
  createdPOs         PurchaseOrder[]   @relation("POCreator")
  createdSOs         SalesOrder[]      @relation("SOCreator")
  createdAdjustments StockAdjustment[] @relation("AdjCreator")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── MASTER DATA ─────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  zones     Zone[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id          String    @id @default(cuid())
  code        String
  name        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  racks       Rack[]
  createdAt   DateTime  @default(now())

  @@unique([code, warehouseId])
}

model Rack {
  id        String   @id @default(cuid())
  code      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  bins      Bin[]
  createdAt DateTime @default(now())

  @@unique([code, zoneId])
}

model Bin {
  id        String   @id @default(cuid())
  code      String
  rackId    String
  rack      Rack     @relation(fields: [rackId], references: [id])
  stocks    Stock[]
  createdAt DateTime @default(now())

  @@unique([code, rackId])
}

model Category {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Unit {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Supplier {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean         @default(true)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Customer {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean      @default(true)
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────

model Product {
  id           String              @id @default(cuid())
  sku          String              @unique
  barcode      String?             @unique
  name         String
  description  String?
  categoryId   String
  category     Category            @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit                @relation(fields: [unitId], references: [id])
  costPrice    Decimal             @default(0) @db.Decimal(15, 2)
  sellPrice    Decimal             @default(0) @db.Decimal(15, 2)
  minStock     Int                 @default(0)
  maxStock     Int                 @default(0)
  reorderPoint Int                 @default(0)
  weight       Decimal?            @db.Decimal(10, 3)
  dimensions   String?
  isActive     Boolean             @default(true)
  stocks       Stock[]
  poItems      PurchaseOrderItem[]
  soItems      SalesOrderItem[]
  movements    StockMovement[]
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// ─── INVENTORY ────────────────────────────────────────────────────────────────

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  binId       String
  bin         Bin       @relation(fields: [binId], references: [id])
  qty         Decimal   @default(0) @db.Decimal(15, 3)
  reservedQty Decimal   @default(0) @db.Decimal(15, 3)
  batchNo     String?
  expiryDate  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, binId, batchNo])
}

model StockMovement {
  id           String       @id @default(cuid())
  refNo        String       @unique
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  type         MovementType
  qty          Decimal      @db.Decimal(15, 3)
  qtyBefore    Decimal      @db.Decimal(15, 3)
  qtyAfter     Decimal      @db.Decimal(15, 3)
  fromBinId    String?
  toBinId      String?
  poItemId     String?
  soItemId     String?
  adjustmentId String?
  notes        String?
  createdBy    String
  createdAt    DateTime     @default(now())
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

// ─── PURCHASE ORDER ────────────────────────────────────────────────────────────

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNo          String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        POStatus            @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String?
  totalAmount   Decimal             @default(0) @db.Decimal(15, 2)
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]
  createdBy     String
  createdByUser User?               @relation("POCreator", fields: [createdBy], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum POStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  qtyOrdered  Decimal       @db.Decimal(15, 3)
  qtyReceived Decimal       @default(0) @db.Decimal(15, 3)
  unitPrice   Decimal       @db.Decimal(15, 2)
  totalPrice  Decimal       @db.Decimal(15, 2)
  notes       String?
}

model GoodsReceipt {
  id          String             @id @default(cuid())
  grNo        String             @unique
  poId        String
  po          PurchaseOrder      @relation(fields: [poId], references: [id])
  receiptDate DateTime           @default(now())
  notes       String?
  items       GoodsReceiptItem[]
  createdBy   String
  createdAt   DateTime           @default(now())
}

model GoodsReceiptItem {
  id          String       @id @default(cuid())
  grId        String
  gr          GoodsReceipt @relation(fields: [grId], references: [id], onDelete: Cascade)
  poItemId    String
  productId   String
  qtyReceived Decimal      @db.Decimal(15, 3)
  binId       String
  batchNo     String?
  expiryDate  DateTime?
}

// ─── SALES ORDER ──────────────────────────────────────────────────────────────

model SalesOrder {
  id            String           @id @default(cuid())
  soNo          String           @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  status        SOStatus         @default(DRAFT)
  orderDate     DateTime         @default(now())
  requiredDate  DateTime?
  shippedDate   DateTime?
  notes         String?
  totalAmount   Decimal          @default(0) @db.Decimal(15, 2)
  items         SalesOrderItem[]
  pickings      PickingOrder[]
  createdBy     String
  createdByUser User?            @relation("SOCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum SOStatus {
  DRAFT
  CONFIRMED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model SalesOrderItem {
  id         String     @id @default(cuid())
  soId       String
  so         SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  qtyOrdered Decimal    @db.Decimal(15, 3)
  qtyPicked  Decimal    @default(0) @db.Decimal(15, 3)
  unitPrice  Decimal    @db.Decimal(15, 2)
  totalPrice Decimal    @db.Decimal(15, 2)
  notes      String?
}

model PickingOrder {
  id        String        @id @default(cuid())
  pickNo    String        @unique
  soId      String
  so        SalesOrder    @relation(fields: [soId], references: [id])
  status    PickStatus    @default(PENDING)
  items     PickingItem[]
  createdBy String
  createdAt DateTime      @default(now())
}

enum PickStatus {
  PENDING
  PICKING
  DONE
  CANCELLED
}

model PickingItem {
  id          String       @id @default(cuid())
  pickId      String
  pick        PickingOrder @relation(fields: [pickId], references: [id], onDelete: Cascade)
  soItemId    String
  productId   String
  binId       String
  qtyRequired Decimal      @db.Decimal(15, 3)
  qtyPicked   Decimal      @default(0) @db.Decimal(15, 3)
  isDone      Boolean      @default(false)
}

// ─── ADJUSTMENT ───────────────────────────────────────────────────────────────

model StockAdjustment {
  id            String                @id @default(cuid())
  adjNo         String                @unique
  reason        String
  status        AdjStatus             @default(DRAFT)
  notes         String?
  items         StockAdjustmentItem[]
  createdBy     String
  createdByUser User                  @relation("AdjCreator", fields: [createdBy], references: [id])
  approvedBy    String?
  createdAt     DateTime              @default(now())
}

enum AdjStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model StockAdjustmentItem {
  id         String          @id @default(cuid())
  adjId      String
  adj        StockAdjustment @relation(fields: [adjId], references: [id], onDelete: Cascade)
  productId  String
  binId      String
  qtySystem  Decimal         @db.Decimal(15, 3)
  qtyActual  Decimal         @db.Decimal(15, 3)
  difference Decimal         @db.Decimal(15, 3)
  notes      String?
}

// ─── ACTIVITY LOG ────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ip        String?
  createdAt DateTime @default(now())
}
